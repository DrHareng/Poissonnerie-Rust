# Exemple Nginx — Poissonnerie (/infinity) + Dauphiné (/dauphine)
#
# Sur le VPS :
#   sudo cp deploy/nginx-infinity.conf.example /etc/nginx/sites-available/poissonnerie
#   (ou remplacer le contenu du fichier existant)
#   sudo ln -sf /etc/nginx/sites-available/poissonnerie /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    # API derrière le préfixe /infinity/api → serveur Rust /api
    location /infinity/api/ {
        proxy_pass http://127.0.0.1:3000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_connect_timeout 10s;
    }

    # APK de l'organisateur : fichier réel, pas la page d'accueil.
    location = /infinity/organisateur.apk {
        alias /opt/poissonnerie/frontend/dist/organisateur.apk;
        default_type application/vnd.android.package-archive;
        add_header Content-Disposition 'attachment; filename="Gestion-de-tournoi-Infinity.apk"';
        add_header Cache-Control "no-cache";
    }

    # Fichiers hashés : un chunk absent doit répondre 404, pas index.html.
    # Sinon le navigateur refuse le module (« error loading dynamically imported module »).
    location ^~ /infinity/assets/ {
        alias /opt/poissonnerie/frontend/dist/assets/;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Front Vue Infinity (SPA) — alias + fallback named location (évite la boucle try_files)
    location /infinity/ {
        alias /opt/poissonnerie/frontend/dist/;
        try_files $uri $uri/ @infinity_spa;
    }

    location @infinity_spa {
        rewrite ^ /infinity/index.html last;
    }

    location = /infinity/index.html {
        alias /opt/poissonnerie/frontend/dist/index.html;
        add_header Cache-Control "no-cache";
    }

    # API Dauphiné (même backend) /dauphine/api → serveur Rust /api
    location /dauphine/api/ {
        proxy_pass http://127.0.0.1:3000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_connect_timeout 10s;
    }

    location ^~ /dauphine/assets/ {
        alias /opt/poissonnerie/frontend-dauphine/dist/assets/;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Front Vue Dauphiné (SPA distincte)
    location /dauphine/ {
        alias /opt/poissonnerie/frontend-dauphine/dist/;
        try_files $uri $uri/ @dauphine_spa;
    }

    location @dauphine_spa {
        rewrite ^ /dauphine/index.html last;
    }

    location = /dauphine/index.html {
        alias /opt/poissonnerie/frontend-dauphine/dist/index.html;
        add_header Cache-Control "no-cache";
    }

    # Optionnel : racine du VPS → app Infinity
    location = / {
        return 302 /infinity/;
    }
}
